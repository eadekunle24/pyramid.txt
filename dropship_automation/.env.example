# Leave everything blank to run entirely in SANDBOX mode (mock supplier +
# mock storefront, no real accounts or money involved). Fill in a section
# below to switch that piece over to the real, live service.

# --- Shopify (live storefront) ---
# Create a custom app in your store admin, grant read/write access to
# products, inventory, and orders, and copy the Admin API access token.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# --- CJ Dropshipping (live supplier) ---
# Requires an API-enabled CJ Dropshipping account.
CJ_API_EMAIL=
CJ_API_KEY=

# --- Anthropic (AI-written product listings) ---
# Without this, listing copy is generated from a deterministic template.
ANTHROPIC_API_KEY=

# --- Business rules ---
MARKUP_MULTIPLIER=2.5
MIN_SUPPLIER_RATING=4.3
MIN_SUPPLIER_ORDERS=500
PRODUCT_CATEGORY=
SOURCING_INTERVAL_HOURS=24
FULFILLMENT_INTERVAL_MINUTES=15
